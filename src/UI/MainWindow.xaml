<Window x:Class="IndustrialProtocolAssistant.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IndustrialProtocolAssistant.UI"
        xmlns:views="clr-namespace:IndustrialProtocolAssistant.UI.Views"
        Title="工业协议调试助手 / 轻量 HMI" Height="830" Width="1180">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接配置 + 运行状态（协议参数由驱动自描述，动态表单随驱动切换） -->
        <views:DeviceBarView Grid.Row="0"/>

        <!-- 主工作区：数据监控（内含实时监控 / 配置管理）/ 手动收发 / 报文监控 / 日志 -->
        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="数据监控">
                <TabControl>
                    <TabItem Header="实时监控">
                        <views:MonitorTabView/>
                    </TabItem>
                    <TabItem Header="配置管理">
                        <views:ConfigTabView/>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="手动收发" ToolTip="串口助手式原始帧调试：任意 Hex 请求→立即显示原始应答。仅线帧协议（SerialFree / Socket / ModbusRTU / ModbusTCP）可用；S7 / OPC UA / MQTT 为高层语义协议，请用 Tag 读写">
                <views:ManualRawTabView/>
            </TabItem>
            <TabItem Header="报文监控">
                <views:TrafficTabView/>
            </TabItem>
            <TabItem Header="日志">
                <views:LogTabView/>
            </TabItem>
        </TabControl>

        <!-- 报警事件 -->
        <views:AlarmBarView Grid.Row="2" Margin="0,8,0,0"/>

        <!-- 运行提示（底部单行消息条）：只保留最近一条重要操作反馈，新提示整体覆盖旧提示，不堆积不滚动；
             与顶部连接状态指示灯完全分离，详细过程请以右侧系统日志为准 -->
        <views:NoticeBarView Grid.Row="3" Margin="0,8,0,0"/>
    </Grid>
</Window>
