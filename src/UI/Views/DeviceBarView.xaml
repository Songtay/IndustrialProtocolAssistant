<UserControl x:Class="IndustrialProtocolAssistant.UI.Views.DeviceBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IndustrialProtocolAssistant.UI">
    <!-- 连接配置 + 运行状态（协议参数由驱动自描述，动态表单随驱动切换） -->
    <GroupBox Header="设备连接" Padding="8">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="驱动:" VerticalAlignment="Center"/>
                <ComboBox Width="110" Margin="4,0" ItemsSource="{Binding DriverTypes}" SelectedItem="{Binding DriverType}"
                          ToolTip="协议驱动：ModbusTCP(网口) / ModbusRTU(串口) / SerialFree(串口自由协议,自定义帧) / Socket(TCP自由协议,自定义帧) / S7(西门子以太网) / OPC UA(节点树浏览)"/>
                <TextBlock Text="轮询(ms):" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Width="60" Margin="4,0" Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="连接并启动" Margin="14,0,0,0" Width="110" Command="{Binding StartCommand}"
                        ToolTip="仅建立连接并保持在线，不会自动读取；请在“数据监控”页点“读取”开始采样，点“停止”可暂停采样（连接保持）"/>
                <Button Content="停止" Margin="8,0,0,0" Width="70" Command="{Binding StopCommand}"/>
                <Button Content="导出配置…" Width="96" Margin="10,0,0,0" Command="{Binding ExportConfigCommand}"
                        ToolTip="把当前驱动参数 + 整组 Tag 备份为 JSON（跨机器/场景迁移）"/>
                <Button Content="导入配置…" Width="96" Margin="8,0,0,0" Command="{Binding ImportConfigCommand}"
                        ToolTip="从 JSON 恢复整套配置（需先停止采集）"/>

                <!-- 分隔线 -->
                <Rectangle Width="1" Height="22" Margin="14,0,14,0" Fill="#DDDDDD" VerticalAlignment="Center"/>

                <!-- 状态指示灯 -->
                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#9E9E9E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Connecting">
                                    <Setter Property="Fill" Value="#FFB300"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Running">
                                    <Setter Property="Fill" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                                    <Setter Property="Fill" Value="#F44336"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Stopped">
                                    <Setter Property="Fill" Value="#607D8B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- 状态文字：仅错误时标红，其余保持常规色 -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#333333"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 动态连接参数表单：字段由驱动声明，切换驱动自动变化 -->
            <ItemsControl ItemsSource="{Binding ConnectionParams}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                       ToolTip="{Binding ToolTip}"/>
                            <!-- 文本 / 整数 -->
                            <TextBox Width="{Binding Width}" Margin="4,0" VerticalContentAlignment="Center"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding ToolTip}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- 密码 -->
                            <PasswordBox Width="{Binding Width}" Margin="4,0" VerticalContentAlignment="Center"
                                         local:PasswordBoxHelper.BoundPassword="{Binding Value}">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <!-- 下拉选择（波特率 / 安全策略等固定候选） -->
                            <ComboBox Width="{Binding Width}" Margin="4,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                                      ToolTip="{Binding ToolTip}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <!-- 串口（可编辑下拉 + 系统枚举 + 刷新按钮） -->
                            <ComboBox Width="{Binding Width}" Margin="4,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Options}" IsEditable="True"
                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding ToolTip}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSerialPort}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <Button Content="⟳" Width="22" Margin="2,0,0,0" Padding="0" VerticalAlignment="Center"
                                    Command="{Binding DataContext.RefreshSerialPortsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="刷新可用串口列表">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSerialPort}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 必填标记 -->
                            <TextBlock Text="*" Foreground="#E53935" VerticalAlignment="Center" FontSize="13"
                                       ToolTip="必填项">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </GroupBox>
</UserControl>
