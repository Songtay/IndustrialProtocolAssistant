<UserControl x:Class="IndustrialProtocolAssistant.UI.Views.TrafficTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：行1 暂停/清空/状态/导出；行2 过滤（关键字/方向/驱动） -->
        <StackPanel Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Width="72" Command="{Binding ToggleTrafficPauseCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="暂停"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrafficPaused}" Value="True">
                                    <Setter Property="Content" Value="继续"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="清空" Width="72" Margin="8,0,0,0" Command="{Binding ClearTrafficCommand}"/>
                <Button Content="导出报文…" Width="96" Margin="8,0,0,0" Command="{Binding ExportTrafficCommand}"
                        ToolTip="导出当前可见报文（受过滤条件影响）：按扩展名存为 CSV / TXT / HEX"/>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                           Text="{Binding TrafficStatus, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="过滤:" VerticalAlignment="Center" Foreground="#555555"/>
                <ComboBox Width="88" Margin="4,0" ItemsSource="{Binding TrafficDirectionOptions}"
                          SelectedItem="{Binding TrafficDirectionFilter}"
                          ToolTip="按方向过滤：发送 TX / 接收 RX"/>
                <ComboBox Width="110" Margin="4,0" ItemsSource="{Binding TrafficDriverOptions}"
                          SelectedItem="{Binding TrafficDriverFilter}"
                          ToolTip="按驱动过滤"/>
                <TextBox Width="170" Margin="4,0"
                         Text="{Binding TrafficFilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="关键字匹配 操作/驱动/文本/ASCII/Hex；Hex 支持 01 03 或 0103 两种写法"/>
                <Button Content="清空条件" Width="80" Margin="4,0,0,0"
                        Command="{Binding ResetTrafficFilterCommand}"
                        ToolTip="清除关键字/方向/驱动过滤"/>
                <TextBlock Text="选中行右键可复制 HEX / ASCII" VerticalAlignment="Center"
                           Foreground="#999999" FontSize="11" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 报文表格（最新在上；ItemsSource 为过滤视图 TrafficView） -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding TrafficView}"
                  SelectedItem="{Binding SelectedTraffic}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  SelectionMode="Single" RowHeight="22"
                  FontSize="12"
                  ContextMenuOpening="TrafficContextMenu_Opening">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="复制 HEX" Command="{Binding CopyHexCommand}"
                              CommandParameter="{Binding SelectedTraffic}"
                              ToolTip="把选中行完整载荷复制为空格分隔的大写 Hex"/>
                    <MenuItem Header="复制 ASCII" Command="{Binding CopyAsciiCommand}"
                              CommandParameter="{Binding SelectedTraffic}"
                              ToolTip="把选中行完整载荷复制为 ASCII 视图（不可打印字节映射为 .）"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="86"/>
                <DataGridTemplateColumn Header="方向" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Direction}" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding DirectionText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0D6EFD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                <Setter Property="Foreground" Value="#198754"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding DeltaText}" Width="52">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Δt(ms)" ToolTip="本帧与上一帧的间隔（毫秒），定位粘包 / 慢响应 / 超时"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="驱动" Binding="{Binding DriverType}" Width="54"/>
                <DataGridTextColumn Header="操作 / 对象" Binding="{Binding Description}" Width="*"
                                    ToolTipService.ToolTip="{Binding Description}"/>
                <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="42"/>
                <DataGridTextColumn Header="载荷预览 (Hex)" Binding="{Binding PayloadPreview}" Width="240"
                                    FontFamily="Consolas" FontSize="11"/>
                <DataGridTextColumn Header="文本" Binding="{Binding PayloadText}" Width="170"
                                    ToolTipService.ToolTip="{Binding PayloadText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 选中行载荷详情：Hex + ASCII 双栏 -->
        <GroupBox Grid.Row="2" Header="载荷详情（Hex + ASCII，选中上方任意一行查看）" Padding="4" Margin="0,6,0,0">
            <TextBox IsReadOnly="True" Text="{Binding SelectedTraffic.Detail}"
                     FontFamily="Consolas" FontSize="12"
                     Background="#FCFCFC" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</UserControl>
