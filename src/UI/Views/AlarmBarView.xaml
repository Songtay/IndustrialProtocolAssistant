<UserControl x:Class="IndustrialProtocolAssistant.UI.Views.AlarmBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 报警/日志 -->
    <GroupBox Header="报警事件">
        <DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="120"/>
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="80"/>
                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </GroupBox>
</UserControl>
