<UserControl x:Class="IndustrialProtocolAssistant.UI.Views.ConfigTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="数据点 (Tag) 管理" Padding="8">
            <StackPanel>
                <!-- 行1：名称 / 地址 / 类型 / 长度 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="名称:" VerticalAlignment="Center"/>
                    <TextBox Width="100" Margin="4,0" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="地址:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Margin="4,0" Text="{Binding NewTagAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding TagAddressHint}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Width" Value="50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DriverType}" Value="OpcUa">
                                        <Setter Property="Width" Value="200"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DriverType}" Value="S7">
                                        <Setter Property="Width" Value="170"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DriverType}" Value="SerialFree">
                                        <Setter Property="Width" Value="330"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DriverType}" Value="Socket">
                                        <Setter Property="Width" Value="330"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Content="浏览…" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center"
                            Command="{Binding OpenNodeBrowserCommand}"
                            ToolTip="打开 OPC UA 节点树浏览器，选中节点后填入地址">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrowseButtonVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="类型:" VerticalAlignment="Center" Margin="8,0,0,0"
                               ToolTip="{Binding TagTypeHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagTypeVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Width="80" Margin="4,0" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding NewTagType}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagTypeVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Text="长度:" VerticalAlignment="Center" Margin="8,0,0,0"
                               ToolTip="{Binding TagLengthHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagLengthVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Width="45" Margin="4,0" Text="{Binding NewTagLength, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding TagLengthHint}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagLengthVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- 发送 Topic（仅 MQTT）：该 Tag 独立的下发/发布 Topic，覆盖「订阅 Topic + 写后缀」 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTagWriteAddressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="发送 Topic:" VerticalAlignment="Center"
                               ToolTip="{Binding TagWriteAddressHint}"/>
                    <TextBox Width="240" Margin="4,0" Text="{Binding NewTagWriteAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding TagWriteAddressHint}"/>
                    <TextBlock Text="{Binding TagWriteAddressHint}" Foreground="Gray" FontSize="11"
                               Width="330" TextTrimming="CharacterEllipsis"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               ToolTip="{Binding TagWriteAddressHint}"/>
                </StackPanel>

                <!-- 行2：地址语法帮助提示，单独一行避免挤占录入框 -->
                <TextBlock Text="{Binding TagAddressHint}" Foreground="Gray" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- OPC UA 时由"浏览…"按钮提供引导，隐藏冗余提示 -->
                                <DataTrigger Binding="{Binding IsBrowseButtonVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 行3：报警上下限 / 死区 / 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="上限:" VerticalAlignment="Center" ToolTip="{Binding AlarmHint}"/>
                    <TextBox Width="55" Margin="4,0" Text="{Binding NewTagHighAlarm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding AlarmHint}"
                             IsEnabled="{Binding IsAlarmEnabled}"/>
                    <TextBlock Text="下限:" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding AlarmHint}"/>
                    <TextBox Width="55" Margin="4,0" Text="{Binding NewTagLowAlarm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding AlarmHint}"
                             IsEnabled="{Binding IsAlarmEnabled}"/>
                    <TextBlock Text="死区:" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBox Width="45" Margin="4,0" Text="{Binding Deadband}"
                             ToolTip="数值型：相邻变化量小于该值不落库；Bool/字符串：值未变化不落库。填 0 关闭过滤"/>
                    <Button Command="{Binding AddTagCommand}" Margin="14,0,0,0" Width="100"
                            ToolTip="新增数据点；选中表格行后点“编辑选中”，本按钮变为“保存修改”">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="添加 Tag"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTagVisible}" Value="True">
                                        <Setter Property="Content" Value="保存修改"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="编辑选中" Width="85" Margin="8,0,0,0" Command="{Binding EditTagCommand}"
                            ToolTip="把选中的表格行回填到上方表单就地修改；保存后同步采集引擎与数据库">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTag}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditingTagVisible}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="删除选中" Width="85" Margin="8,0,0,0" Command="{Binding DeleteTagCommand}"/>
                    <Button Content="取消编辑" Width="85" Margin="8,0,0,0" Command="{Binding CancelEditTagCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTagVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                               Text="{Binding TagEditorHint, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Tag 配置 (持久化)" Padding="4" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Binding="{Binding AreaText}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.AreaColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="地址" Binding="{Binding AreaAddress}" Width="260"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="发送 Topic" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.DriverType, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Mqtt">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WriteAddressText}"
                                           ToolTip="{Binding WriteAddressText}" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.DriverType, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Mqtt">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="60"/>
                    <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="45"/>
                    <DataGridTextColumn Header="上限" Binding="{Binding HighAlarmText}" Width="60"/>
                    <DataGridTextColumn Header="下限" Binding="{Binding LowAlarmText}" Width="60"/>
                    <DataGridTemplateColumn Header="操作" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="读一次" Padding="4,1" HorizontalAlignment="Center"
                                        Command="{Binding DataContext.ReadOnceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="立即手动读一次该 Tag（需引擎运行中），用于快速验证某个地址的真实值"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
