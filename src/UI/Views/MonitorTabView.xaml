<UserControl x:Class="IndustrialProtocolAssistant.UI.Views.MonitorTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:IndustrialProtocolAssistant.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 读取控制 + 下发写入 -->
            <RowDefinition Height="*"/>      <!-- 实时表格 + 曲线 -->
        </Grid.RowDefinitions>

        <!-- 顶部操作条：读取控制（读取/停止按钮）+ 下发写入 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="读取控制" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="读取" Width="76" Command="{Binding StartReadingCommand}"
                            ToolTip="连接建立后点击开始自动轮询采样（按顶部轮询间隔读取全部 Tag）">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="Running">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="停止" Width="76" Margin="8,0,0,0" Command="{Binding StopReadingCommand}"
                            ToolTip="暂停自动轮询采样（保持已连接；仍可下发写入 / 手动收发 / 单点“读一次”）">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="Running">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReading}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"
                               Text="启动连接后默认不读取，点“读取”开始采样"/>
                </StackPanel>
            </GroupBox>

            <views:WriteBarView Grid.Column="1" Margin="8,0,0,0"/>
        </Grid>

        <!-- 实时数据 + 实时/历史曲线 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="实时数据" Padding="4">
                <DataGrid ItemsSource="{Binding Tags}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="实时值" Binding="{Binding CurrentValue}" Width="90"/>
                        <DataGridTextColumn Header="质量" Binding="{Binding CurrentQuality}" Width="60"/>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedTime}" Width="85"/>
                        <DataGridTemplateColumn Header="操作" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="读一次" Padding="4,1" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.ReadOnceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="立即手动读一次该 Tag（不等轮询周期），值/质量即刻刷新并落库"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <TabControl Grid.Column="1" Margin="8,0,0,0">
                <TabItem Header="实时趋势">
                    <lvc:CartesianChart x:Name="RealTimeChart" Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxis}"/>
                </TabItem>
                <TabItem Header="历史曲线">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="Tag:" VerticalAlignment="Center"/>
                            <ComboBox Width="180" Margin="4,0" ItemsSource="{Binding Tags}"
                                      SelectedItem="{Binding HistoryTag}" DisplayMemberPath="DisplayName"/>
                            <TextBlock Text="最近(分钟):" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Width="60" Margin="4,0" Text="{Binding HistoryMinutes}"/>
                            <Button Content="查询" Margin="8,0,0,0" Width="70" Command="{Binding LoadHistoryCommand}"/>
                            <Button Content="导出 CSV" Margin="8,0,0,0" Width="80" Command="{Binding ExportHistoryCommand}"
                                    ToolTip="将当前查询结果导出为 CSV 文件"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                                       Text="{Binding HistoryStatus, Mode=OneWay}"/>
                        </StackPanel>
                        <lvc:CartesianChart x:Name="HistoryChart" Grid.Row="1" Series="{Binding HistorySeries}" XAxes="{Binding HistoryXAxis}"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
