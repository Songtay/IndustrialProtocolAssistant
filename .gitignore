.nuget/
*.nupkg.metadata
*.nuget.g.props
*.nuget.g.targets
*.nuget.props
*.nuget.targets

# --------------------------------------------------------------------------
# 4. 测试与覆盖率报告
# --------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]enchmarkDotNet.Artifacts/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
