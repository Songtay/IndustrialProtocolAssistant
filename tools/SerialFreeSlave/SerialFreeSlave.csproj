<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SerialFreeSlave</RootNamespace>
    <AssemblyName>SerialFreeSlave</AssemblyName>
    <Description>SerialFree 串口从站模拟器：监听一个串口，按 RTU 风格或自定义规则应答主站请求，供工业协议调试助手的 SerialFree 主站驱动联调演示。</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
